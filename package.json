{
  "name": "wordmaster",
  "productName": "WordMaster",
  "version": "1.0.0",
  "description": "AI 驱动的英语听说读写分层训练桌面软件",
  "main": "main.js",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --win dir",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.wordmaster.app",
    "productName": "WordMaster",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "shortcutName": "WordMaster 英语训练"
    }
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
